{
    "name": "tampermonkey-markdown-enhancer",
    "version": "0.0.0",
    "private": true,
    "repository": "https://github.com/kevin062397/TampermonkeyMarkdownEnhancer",
    "license": "UNLICENSED",
    "type": "module",
    "scripts": {
        "prebuild": "npm run format",
        "build": "vite build && npm run validate:build",
        "check-format": "prettier --check .",
        "clean": "rm -rf dist",
        "dev": "vite",
        "format": "prettier --write .",
        "pretest": "npm run check-format",
        "test": "vitest run",
        "validate:build": "node scripts/validate-build.mjs"
    },
    "devDependencies": {
        "@types/tampermonkey": "^5.5.0",
        "jsdom": "30.1.1",
        "prettier": "^3.9.9",
        "prettier-plugin-organize-imports": "^4.3.0",
        "prettier-plugin-packagejson": "^3.0.2",
        "typescript": "^7.0.2",
        "vite": "^8.3.1",
        "vite-plugin-monkey": "^8.1.1",
        "vitest": "5.0.2"
    }
}
