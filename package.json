{
    "name": "tampermonkey-markdown-enhancer",
    "version": "0.0.0",
    "private": true,
    "repository": "https://github.com/kevin062397/TampermonkeyMarkdownEnhancer",
    "license": "UNLICENSED",
    "type": "module",
    "scripts": {
        "prebuild": "npm run format",
        "build": "vite build",
        "postbuild": "npm run validate:build",
        "check-format": "prettier --check .",
        "clean": "rm -rf dist",
        "dev": "vite",
        "format": "prettier --write .",
        "test": "vitest run",
        "typecheck": "tsc --noEmit",
        "validate:build": "node scripts/validate-build.mjs",
        "verify": "npm run check-format && npm run typecheck && npm run test && npm run build"
    },
    "devDependencies": {
        "@types/tampermonkey": "^5.5.0",
        "jsdom": "^31.0.1",
        "prettier": "^3.10.1",
        "prettier-plugin-organize-imports": "^4.3.0",
        "prettier-plugin-packagejson": "^3.1.0",
        "typescript": "^6.0.3",
        "vite": "^8.3.8",
        "vite-plugin-monkey": "^8.1.1",
        "vitest": "^5.1.0"
    }
}
